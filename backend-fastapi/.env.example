PORT=8000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=change-me
GEMINI_API_KEY=your-gemini-api-key

# Optional: relational analytics store (interview_summaries / question_scores).
# App runs fine without this set - analytics endpoints just stay disabled.
POSTGRES_URI=postgresql://<user>:<password>@<host>/<database>?sslmode=require
